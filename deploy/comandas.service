# /etc/systemd/system/comandas.service — servidor Django em produção (gunicorn)
[Unit]
Description=Comandas Brasil (Django)
After=network.target mariadb.service

[Service]
User=comandas
Group=comandas
WorkingDirectory=/srv/comandas/servidor
EnvironmentFile=/srv/comandas/.env
ExecStart=/srv/comandas/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8100 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
